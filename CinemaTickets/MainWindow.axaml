
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CinemaTickets.MainWindow"
        Title="Pink Cinema"
        Width="1180"
        Height="760"
        MinWidth="790"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#FFF8FC">

    <Window.Styles>

        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#965A7A"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
        </Style>

        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="#FCE7F3"/>
        </Style>

        <Style Selector="Button.movieAction:pointerover">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#BE185D"/>
            <Setter Property="BorderBrush" Value="#BE185D"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </Window.Styles>

    <Grid ColumnDefinitions="224,*">

        <Border Grid.Column="0"
                Background="#FFF0F7"
                BorderBrush="#F4D6E5"
                BorderThickness="0,0,1,0"
                Padding="18,28">

            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <StackPanel Spacing="8" Margin="8,4,0,42">

                    <TextBlock Text="PINK"
                               FontSize="30"
                               FontWeight="ExtraBold"
                               Foreground="#9D174D"/>

                    <TextBlock Text="C I N E M A"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#BE185D"/>

                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="8">

                    <Button x:Name="MoviesButton"
                            Classes="nav"
                            Click="Movies_Click"
                            Content="Афиша"
                            HorizontalAlignment="Stretch"/>

                    <Button x:Name="SessionsButton"
                            Classes="nav"
                            Click="Sessions_Click"
                            Content="Сеансы"
                            HorizontalAlignment="Stretch"/>

                    <Button x:Name="TicketsButton"
                            Classes="nav"
                            Click="Tickets_Click"
                            Content="Билеты"
                            HorizontalAlignment="Stretch"/>

                </StackPanel>

            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Margin="32,26"
              RowDefinitions="Auto,*"
              RowSpacing="24">

            <Grid ColumnDefinitions="*,Auto">

                <StackPanel Spacing="5">

                    <TextBlock x:Name="SectionTitle"
                               Text="Афиша"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#831843"/>

                    <TextBlock x:Name="SectionSubtitle"
                               Text="Выбирай историю по настроению"
                               FontSize="14"
                               Foreground="#AC7894"/>

                </StackPanel>

            </Grid>

            <Grid Grid.Row="1">

                <ScrollViewer x:Name="MoviesPage"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Spacing="25">

                        <Border Background="#9D174D"
                                CornerRadius="20"
                                Padding="28"
                                ClipToBounds="True">

                            <Grid ColumnDefinitions="*,125">

                                <StackPanel Spacing="12">

                                    <TextBlock Text="PINK CINEMA ПРЕДСТАВЛЯЕТ"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#FBCFE8"/>

                                    <TextBlock Text="Время хорошего кино."
                                               FontSize="27"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               TextWrapping="Wrap"/>

                                    <TextBlock
                                        Text="Выбирай фильм, удобный сеанс и своё любимое место."
                                        FontSize="13"
                                        Foreground="#FCE7F3"
                                        TextWrapping="Wrap"/>

                                </StackPanel>

                                <Border Grid.Column="1"
                                        Width="112"
                                        Height="112"
                                        Background="#BE397C"
                                        CornerRadius="60"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right">

                                    <TextBlock Text="✦"
                                               FontSize="65"
                                               Foreground="#FBCFE8"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">

                            <StackPanel Spacing="5">

                                <TextBlock Text="Сейчас в кино"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           Foreground="#831843"/>

                                <TextBlock x:Name="ResultsText"
                                           FontSize="13"
                                           Foreground="#AC7894"/>

                            </StackPanel>

                            <TextBox x:Name="SearchBox"
                                     Grid.Column="1"
                                     Width="230"
                                     Height="42"
                                     VerticalAlignment="Center"
                                     Watermark="Поиск фильма..."
                                     Background="White"
                                     Foreground="#831843"
                                     BorderBrush="#F0D2E1"
                                     Padding="12,8"
                                     TextChanged="SearchBox_TextChanged"/>

                        </Grid>

                        <WrapPanel x:Name="MoviesPanel"
                                   Orientation="Horizontal"/>

                    </StackPanel>

                </ScrollViewer>

                <ContentControl x:Name="PageHost"
                                IsVisible="False"/>

            </Grid>

        </Grid>

    </Grid>
</Window>
