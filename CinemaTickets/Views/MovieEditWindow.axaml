<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CinemaTickets.Views.MovieEditWindow"
        Title="Фильм"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#FFF8FC">

  <Window.Styles>
    <Style Selector="Button.pink">
      <Setter Property="Background" Value="#BE185D"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#BE185D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="26,11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.pink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#BE185D"/>
      <Setter Property="BorderBrush" Value="#BE185D"/>
    </Style>
    <Style Selector="Button.outline">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#BE185D"/>
      <Setter Property="BorderBrush" Value="#FBCFE8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="26,11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.outline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFF0F7"/>
      <Setter Property="Foreground" Value="#BE185D"/>
      <Setter Property="BorderBrush" Value="#BE185D"/>
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#831843"/>
      <Setter Property="BorderBrush" Value="#F0D2E1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="12,10"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#AD648A"/>
      <Setter Property="Margin" Value="2,0,0,5"/>
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#BE123C"/>
      <Setter Property="Margin" Value="2,4,0,0"/>
      <Setter Property="IsVisible" Value="False"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Styles>

  <StackPanel>
    <Border Height="6" Background="#BE185D"/>

    <StackPanel Margin="30,24,30,26" Spacing="14">

      <StackPanel Spacing="4">
        <TextBlock Text="✦  PINK CINEMA" FontSize="11" FontWeight="SemiBold"
                   LetterSpacing="3" Foreground="#BE185D"/>
        <TextBlock x:Name="HeaderText" FontSize="26" FontWeight="Bold" Foreground="#831843"/>
      </StackPanel>

      <StackPanel>
        <TextBlock Classes="label" Text="НАЗВАНИЕ"/>
        <TextBox x:Name="TitleBox" Watermark="Например, Интерстеллар" MaxLength="100"/>
        <TextBlock x:Name="ErrTitle" Classes="error"/>
      </StackPanel>

      <StackPanel>
        <TextBlock Classes="label" Text="ЖАНР"/>
        <TextBox x:Name="GenreBox" Watermark="Например, Фантастика" MaxLength="50"/>
        <TextBlock x:Name="ErrGenre" Classes="error"/>
      </StackPanel>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
        <StackPanel Grid.Column="0">
          <TextBlock Classes="label" Text="ГОД ВЫПУСКА"/>
          <TextBox x:Name="YearBox" Watermark="2014" MaxLength="4"/>
          <TextBlock x:Name="ErrYear" Classes="error"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Classes="label" Text="ДЛИТЕЛЬНОСТЬ (МИН)"/>
          <TextBox x:Name="DurationBox" Watermark="169" MaxLength="3"/>
          <TextBlock x:Name="ErrDuration" Classes="error"/>
        </StackPanel>
      </Grid>

      <StackPanel>
        <TextBlock Classes="label" Text="ОПИСАНИЕ"/>
        <TextBox x:Name="DescriptionBox" Height="110"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 Watermark="Коротко о сюжете" MaxLength="500"/>
        <TextBlock x:Name="ErrDescription" Classes="error"/>
      </StackPanel>

      <TextBlock x:Name="ErrGeneral" Classes="error" Margin="2,0,0,0"/>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                  Spacing="10" Margin="0,6,0,0">
        <Button x:Name="CancelButton" Classes="outline" Content="Отмена"/>
        <Button x:Name="SaveButton" Classes="pink" Content="Сохранить"/>
      </StackPanel>

    </StackPanel>
  </StackPanel>
</Window>