<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CinemaTickets.PurchaseWindow"
        Title="Подтверждение покупки"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#FFF8FC">

    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#BE185D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#BE185D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#BE185D"/>
            <Setter Property="BorderBrush" Value="#BE185D"/>
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#FBCFE8"/>
            <Setter Property="Foreground" Value="#831843"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Border Margin="24"
            Background="White"
            CornerRadius="18"
            BorderBrush="#F1DCE7"
            BorderThickness="1"
            Padding="24">

        <StackPanel Spacing="14">

            <TextBlock Text="Подтвердите покупку"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#831843"/>

            <TextBlock x:Name="MovieText"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#9D174D"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"/>

            <TextBlock x:Name="TimeText" FontSize="14" Foreground="#AD648A"/>
            <TextBlock x:Name="SeatText" FontSize="14" Foreground="#AD648A"/>
            <TextBlock x:Name="PriceText"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#BE185D"/>

            <TextBlock x:Name="StatusText"
                       FontSize="13"
                       TextWrapping="Wrap"
                       IsVisible="False"/>

            <StackPanel Orientation="Horizontal"
                        Spacing="12"
                        HorizontalAlignment="Right"
                        Margin="0,6,0,0">

                <Button x:Name="CloseButton"
                        Classes="secondary"
                        Content="Отмена"
                        Click="Close_Click"/>

                <Button x:Name="ConfirmButton"
                        Classes="primary"
                        Content="Купить билет"
                        Click="Confirm_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
